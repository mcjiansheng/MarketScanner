// Platform-scoped native link inputs. PLATFORM_NAME is resolved by Xcode to
// iphoneos or iphonesimulator; no legacy Libraries/ fallback is permitted.

MARKETSCANNER_IOS_DEPENDENCY_ROOT = $(PROJECT_DIR)/RTABMapApp/Libraries/$(PLATFORM_NAME)

// The generated simulator prefix is an arm64 slice on every builder. Pinning
// the app side keeps the exact `-sdk iphonesimulator clean build` gate
// deterministic even when the hosted macOS machine itself is x86_64.
ARCHS[sdk=iphonesimulator*] = arm64

OTHER_LDFLAGS = $(inherited) \
    -framework vtk \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/librtabmap_core.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/librtabmap_utilite.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_xfeatures2d.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_video.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_tracking.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_optflow.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_imgproc.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_features2d.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_core.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_calib3d.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_aruco.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_flann.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_ximgproc.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_photo.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_objdetect.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_stitching.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libopencv_imgcodecs.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libamd.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libsuitesparseconfig.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libspqr.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libcxsparse.a" \
    "$(MARKETSCANNER_IOS_DEPENDENCY_ROOT)/lib/libcolamd.a" \
