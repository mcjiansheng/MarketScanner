      "lib/libopencv_core.a",
      "lib/libpcl_common.a",
      "lib/vtk.framework/vtk"
    ],
    "platform_validated_artifacts": [
      "lib/librtabmap_core.a",
      "lib/librtabmap_utilite.a",
      "lib/libopencv_core.a",
      "lib/libpcl_common.a",
      "lib/vtk.framework/vtk"
    ]
  }
